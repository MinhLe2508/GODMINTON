# Sao chép file này thành ".env" (hoặc khai báo thủ công trong XAMPP) rồi điền giá trị thật.
# File ".env" đã được thêm vào .gitignore — KHÔNG commit file .env thật lên GitHub.
# Để trống DB_PORT để hệ thống tự động dò cả cổng 3306 và 3307 trên XAMPP.

DB_HOST=127.0.0.1
DB_PORT=
DB_NAME=badminton_booking
DB_USER=root
DB_PASS=

# Tạo một cặp mới bằng tools/generate-vapid-keys.php; không đưa key thật lên Git.
VAPID_SUBJECT=mailto:admgodminton@gmail.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=


# Transactional email (PHPMailer). Never commit real SMTP credentials.
APP_URL=http://localhost/GODMINTON
APP_ENV=development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=GODMINTON
CONTACT_ADMIN_EMAIL=admgodminton@gmail.com
