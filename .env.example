# Sao chép file này thành ".env" (hoặc khai báo thủ công trong XAMPP) rồi điền giá trị thật.
# File ".env" đã được thêm vào .gitignore — KHÔNG commit file .env thật lên GitHub.

DB_HOST=127.0.0.1
DB_NAME=badminton_booking
DB_USER=root
DB_PASS=

# Dùng cho Push Notification (Tuần 4 — Triết). Tạo bằng: vendor/bin/web-push-vapid-gen
# hoặc https://web-push-codelab.glitch.me/
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
